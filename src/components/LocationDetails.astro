---
// LocationDetails.astro - 3-up metric cards & instant city search bar with dark mode
---

<section class="py-6 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
  <!-- 3-Up Metric Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <!-- Card 1: Qibla Direction -->
    <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.06),0px_2px_4px_rgba(0,0,0,0.04)] hover:border-[#a1a1a1] dark:hover:border-[#404040] transition-all">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-medium uppercase tracking-wider text-[#888888] dark:text-[#737373]">Qibla Bearing</span>
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-[#ededed]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span id="metric-qibla-deg" class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">--°</span>
        <span id="metric-qibla-cardinal" class="text-xs font-mono text-[#888888] dark:text-[#737373]">--</span>
      </div>
      <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1.5 flex items-center gap-1">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        Clockwise from True North
      </p>
    </div>

    <!-- Card 2: Your Location & City -->
    <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.06),0px_2px_4px_rgba(0,0,0,0.04)] hover:border-[#a1a1a1] dark:hover:border-[#404040] transition-all flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono font-medium uppercase tracking-wider text-[#888888] dark:text-[#737373]">Location & Coordinates</span>
          <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] text-rose-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span id="metric-city-name" class="text-lg sm:text-xl font-semibold tracking-tight text-[#171717] dark:text-white truncate">Detecting location...</span>
          <span id="metric-coords-text" class="text-xs font-mono text-[#888888] dark:text-[#737373] mt-0.5">Lat: -- , Lng: --</span>
        </div>
      </div>

      <div class="mt-3 pt-2.5 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between gap-2 flex-wrap">
        <p id="metric-location-source" class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] flex items-center gap-1">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-blue-500"></span>
          <span>GPS Precision</span>
        </p>

        <!-- Try Again / Re-detect Location Button -->
        <button
          id="btn-retry-location-card"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg border border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#1a1a1a] px-2.5 py-1 text-[11px] font-medium text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:border-emerald-500/50 hover:text-emerald-700 dark:hover:text-emerald-300 transition-all cursor-pointer"
          title="Not your exact location? Tap to re-detect with GPS or search town"
        >
          <svg class="h-3 w-3 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Wrong Location? Try Again</span>
        </button>
      </div>
    </div>

    <!-- Card 3: Distance to Kaaba -->
    <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-5 shadow-[0_0_0_1px_rgba(0,0,0,0.06),0px_2px_4px_rgba(0,0,0,0.04)] hover:border-[#a1a1a1] dark:hover:border-[#404040] transition-all">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-medium uppercase tracking-wider text-[#888888] dark:text-[#737373]">Distance to Kaaba</span>
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] text-amber-500">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span id="metric-distance-val" class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">--</span>
        <span id="metric-distance-unit" class="text-xs font-mono text-[#888888] dark:text-[#737373]">km</span>
      </div>
      <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] mt-1.5">
        Direct Geodesic Great-Circle distance to Makkah
      </p>
    </div>
  </div>

  <!-- Instant Search & City Picker Bar -->
  <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-4 shadow-xs">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative flex-1 w-full">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-[#888888]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="city-search-input"
          type="text"
          placeholder="Search any city or country (e.g. London, Istanbul, Jakarta, New York)..."
          class="w-full pl-9 pr-8 py-2 text-xs sm:text-sm rounded-md border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] text-[#171717] dark:text-[#ededed] placeholder-[#888888] dark:placeholder-[#666666] focus:bg-white dark:focus:bg-[#1a1a1a] focus:outline-none focus:ring-1 focus:ring-[#171717] dark:focus:ring-white focus:border-[#171717] dark:focus:border-white transition-all"
        />
        <button
          id="btn-clear-search"
          type="button"
          class="hidden absolute inset-y-0 right-0 flex items-center pr-3 text-[#888888] hover:text-[#171717] dark:hover:text-white"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <button
        id="btn-use-gps"
        type="button"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-md border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] px-3.5 py-2 text-xs font-medium text-[#171717] dark:text-[#ededed] hover:bg-[#f0f0f0] dark:hover:bg-[#222222] transition-colors whitespace-nowrap cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Use Current GPS</span>
      </button>
    </div>

    <!-- Live Search Autocomplete Results Container -->
    <div id="city-search-results" class="hidden mt-3 max-h-60 overflow-y-auto border-t border-[#ebebeb] dark:border-[#262626] pt-2 space-y-1">
      <!-- Populated dynamically via JS -->
    </div>

    <!-- Dynamic User Recent & Frequent Locations Container -->
    <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-[#888888]">
      <span class="font-mono text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1] flex items-center gap-1">
        <span>🕒</span>
        <span>Recent Places:</span>
      </span>
      <div id="recent-locations-pills" class="flex flex-wrap items-center gap-1.5">
        <!-- Dynamically rendered from localStorage -->
      </div>
      <button
        id="btn-save-current-location"
        type="button"
        class="rounded-full bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700/60 px-2.5 py-0.5 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 transition-colors cursor-pointer font-medium flex items-center gap-1"
        title="Bookmark current location"
      >
        <span>⭐</span>
        <span>Save This Place</span>
      </button>
    </div>
  </div>
</section>
