---
// LocationOverlay.astro - Interactive Loading Screen & Diagnostic Overlay for GPS Geolocation with Retry
---

<div
  id="location-loading-overlay"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="overlay-title"
>
  <div class="relative w-full max-w-md rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-6 shadow-2xl transition-all duration-300">
    
    <!-- Top Close Button -->
    <button
      id="btn-close-location-overlay"
      type="button"
      class="absolute top-4 right-4 rounded-full p-1.5 text-[#888888] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1f1f1f] transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- State 1: Active Locating (Radar Animation) -->
    <div id="overlay-state-locating" class="flex flex-col items-center text-center space-y-4">
      <!-- Radar Pulse Animation -->
      <div class="relative flex h-24 w-24 items-center justify-center my-2">
        <div class="absolute h-full w-full rounded-full bg-blue-500/20 animate-ping"></div>
        <div class="absolute h-18 w-18 rounded-full bg-blue-500/30 animate-pulse"></div>
        <div class="relative flex h-14 w-14 items-center justify-center rounded-full bg-blue-600 text-white shadow-md">
          <svg class="h-7 w-7 animate-spin" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
      </div>

      <div class="space-y-1.5">
        <h3 id="overlay-title" class="text-lg font-semibold text-[#171717] dark:text-white">
          Detecting Your Exact Location
        </h3>
        <p id="overlay-locating-msg" class="text-xs text-[#666666] dark:text-[#a1a1a1] leading-relaxed max-w-xs mx-auto">
          Please tap <strong>"Allow"</strong> if prompted by your browser to analyze your exact latitude, longitude, and Qibla bearing.
        </p>
      </div>

      <!-- Live Geodesy Calculation Indicators -->
      <div class="w-full rounded-xl bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] p-3 text-left space-y-2 text-xs font-mono">
        <div class="flex items-center justify-between text-[#4d4d4d] dark:text-[#ededed]">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
            <span>GPS Satellite Fix</span>
          </span>
          <span id="overlay-gps-status" class="text-blue-600 dark:text-blue-400 font-semibold">Querying...</span>
        </div>
        <div class="flex items-center justify-between text-[#4d4d4d] dark:text-[#ededed]">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-amber-500"></span>
            <span>Great-Circle Azimuth</span>
          </span>
          <span id="overlay-azimuth-status" class="text-[#888888] dark:text-[#737373]">Pending</span>
        </div>
        <div class="flex items-center justify-between text-[#4d4d4d] dark:text-[#ededed]">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <span>Local Prayer Times</span>
          </span>
          <span id="overlay-prayer-status" class="text-[#888888] dark:text-[#737373]">Pending</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-center gap-2.5 w-full pt-1">
        <button
          id="btn-overlay-retry"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#1f1f1f] px-4 py-2 text-xs font-medium text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#2a2a2a] transition-all cursor-pointer shadow-xs"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Retry GPS</span>
        </button>

        <button
          id="btn-overlay-search"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-[#171717] dark:bg-white px-4 py-2 text-xs font-semibold text-white dark:text-[#171717] hover:bg-[#2d2d2d] dark:hover:bg-[#f0f0f0] transition-all cursor-pointer shadow-xs"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search Town / City</span>
        </button>
      </div>
    </div>

    <!-- State 2: Success State (Coordinates Acquired) -->
    <div id="overlay-state-success" class="hidden flex-col items-center text-center space-y-3 py-2">
      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-[#171717] dark:text-white">
        Location Successfully Locked!
      </h3>
      <p id="overlay-success-location" class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-medium">
        Iritty, Kerala, India
      </p>
      <p class="text-xs text-[#666666] dark:text-[#888888]">
        Live Qibla azimuth & local prayer schedules are now synchronized.
      </p>
    </div>

    <!-- State 3: Permission Denied / Error State with Clear Retry Instructions -->
    <div id="overlay-state-error" class="hidden flex-col items-center text-center space-y-4 py-1">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-950/60 border border-amber-500/30 text-amber-600 dark:text-amber-400">
        <span class="text-2xl">⚠️</span>
      </div>
      
      <div class="space-y-1">
        <h3 id="overlay-error-title" class="text-base font-semibold text-[#171717] dark:text-white">
          GPS Location Access Needed
        </h3>
        <p id="overlay-error-desc" class="text-xs text-[#666666] dark:text-[#a1a1a1] leading-relaxed max-w-xs mx-auto">
          Location permission was not granted or timed out. Tap the <strong>lock icon 🔒</strong> in your browser address bar and select <strong>"Allow Location"</strong>, then tap Retry below.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-2 w-full pt-1">
        <button
          id="btn-overlay-error-retry"
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl bg-blue-600 text-white px-4 py-2.5 text-xs font-semibold hover:bg-blue-700 transition-all cursor-pointer shadow-xs"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Retry Exact GPS</span>
        </button>

        <button
          id="btn-overlay-error-search"
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#1f1f1f] px-4 py-2.5 text-xs font-medium text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#2a2a2a] transition-all cursor-pointer shadow-xs"
        >
          <span>Search Town / City</span>
        </button>
      </div>
    </div>

  </div>
</div>
