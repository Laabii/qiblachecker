---
// AlertBanner.astro - Clean dismissible error / notice banner for location & sensor states
---

<div id="app-alert-banner" class="hidden w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 transition-all duration-300">
  <div id="alert-banner-container" class="rounded-xl border p-4 flex items-start justify-between gap-3 shadow-xs bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs sm:text-sm">
    <div class="flex items-start gap-2.5">
      <span id="alert-banner-icon" class="text-base sm:text-lg shrink-0">⚠️</span>
      <div class="space-y-1">
        <strong id="alert-banner-title" class="font-semibold block text-[#171717] dark:text-white">Location Notice</strong>
        <p id="alert-banner-message" class="text-[#4d4d4d] dark:text-[#d4d4d4] leading-relaxed">
          Location permission was not granted. Please select your city or click on the map.
        </p>
        <div id="alert-banner-actions" class="pt-1.5 flex flex-wrap items-center gap-2">
          <button
            id="btn-alert-search"
            type="button"
            class="rounded-md bg-[#171717] dark:bg-white text-white dark:text-[#171717] px-3 py-1 text-xs font-semibold hover:bg-[#2d2d2d] dark:hover:bg-[#e0e0e0] transition-colors cursor-pointer"
          >
            Search City
          </button>
        </div>
      </div>
    </div>
    <button
      id="btn-dismiss-alert"
      type="button"
      class="shrink-0 rounded p-1 text-[#888888] hover:text-[#171717] dark:hover:text-white transition-colors"
      aria-label="Dismiss Alert"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>
