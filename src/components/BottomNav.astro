---
// BottomNav.astro - Floating iOS/Android PWA-style bottom navigation bar for mobile
const pathname = (Astro.url.pathname.replace(/\/$/, '') || '/') as string;
const isHome = pathname === '/' || pathname === '';
const isPrayer = pathname === '/prayer';
const isCalendar = pathname === '/calendar';
---

<nav
  aria-label="Mobile Navigation"
  class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-white/95 dark:bg-[#0a0a0a]/95 backdrop-blur-lg border-t border-[#ebebeb] dark:border-[#262626] pb-[max(env(safe-area-inset-bottom),0.5rem)] pt-1.5 px-3 transition-colors duration-200 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] dark:shadow-[0_-4px_20px_rgba(0,0,0,0.4)]"
>
  <div class="max-w-md mx-auto grid grid-cols-4 items-center justify-around gap-1">
    <!-- 1. Compass (Home) -->
    <a
      href="/"
      class={`flex flex-col items-center justify-center py-1 px-2 rounded-xl transition-all ${
        isHome
          ? 'text-amber-600 dark:text-amber-400 font-semibold scale-105'
          : 'text-[#737373] dark:text-[#888888] hover:text-[#171717] dark:hover:text-white'
      }`}
    >
      <div class={`relative flex items-center justify-center h-6 w-6 rounded-lg ${isHome ? 'bg-amber-50 dark:bg-amber-950/50' : ''}`}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isHome ? '2.3' : '1.8'}>
          <circle cx="12" cy="12" r="10" />
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill={isHome ? 'currentColor' : 'none'} />
        </svg>
      </div>
      <span class="text-[10px] mt-0.5 tracking-tight">Compass</span>
    </a>

    <!-- 2. Prayer Times -->
    <a
      href="/prayer"
      class={`flex flex-col items-center justify-center py-1 px-2 rounded-xl transition-all ${
        isPrayer
          ? 'text-emerald-600 dark:text-emerald-400 font-semibold scale-105'
          : 'text-[#737373] dark:text-[#888888] hover:text-[#171717] dark:hover:text-white'
      }`}
    >
      <div class={`relative flex items-center justify-center h-6 w-6 rounded-lg ${isPrayer ? 'bg-emerald-50 dark:bg-emerald-950/50' : ''}`}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isPrayer ? '2.3' : '1.8'}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m-6 4a6 6 0 0112 0v4H6V8zm-2 8h16v4H4v-4zm8-16a1 1 0 100 2 1 1 0 000-2z" />
        </svg>
      </div>
      <span class="text-[10px] mt-0.5 tracking-tight">Prayer</span>
    </a>

    <!-- 3. Hijri Calendar -->
    <a
      href="/calendar"
      class={`flex flex-col items-center justify-center py-1 px-2 rounded-xl transition-all ${
        isCalendar
          ? 'text-amber-600 dark:text-amber-400 font-semibold scale-105'
          : 'text-[#737373] dark:text-[#888888] hover:text-[#171717] dark:hover:text-white'
      }`}
    >
      <div class={`relative flex items-center justify-center h-6 w-6 rounded-lg ${isCalendar ? 'bg-amber-50 dark:bg-amber-950/50' : ''}`}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={isCalendar ? '2.3' : '1.8'}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </div>
      <span class="text-[10px] mt-0.5 tracking-tight">Calendar</span>
    </a>

    <!-- 4. Settings -->
    <button
      id="btn-bottom-nav-settings"
      type="button"
      class="flex flex-col items-center justify-center py-1 px-2 rounded-xl text-[#737373] dark:text-[#888888] hover:text-[#171717] dark:hover:text-white transition-all cursor-pointer"
      aria-label="App Settings"
    >
      <div class="relative flex items-center justify-center h-6 w-6 rounded-lg">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <span class="text-[10px] mt-0.5 tracking-tight">Settings</span>
    </button>
  </div>
</nav>
