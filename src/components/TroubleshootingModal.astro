---
// TroubleshootingModal.astro - Sensor diagnostics & calibration with dark mode
---

<div id="troubleshoot-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-xs transition-opacity duration-300">
  <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-6 shadow-[0_0_0_1px_rgba(0,0,0,0.08),0px_10px_30px_-5px_rgba(0,0,0,0.12),0px_24px_48px_-12px_rgba(0,0,0,0.16)] dark:shadow-[0_0_0_1px_rgba(255,255,255,0.08),0px_10px_30px_rgba(0,0,0,0.8)]">
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#262626] pb-4 mb-4">
      <div>
        <h3 class="text-lg font-semibold tracking-tight text-[#171717] dark:text-white">Compass Calibration & Diagnostics</h3>
        <p class="text-xs text-[#888888] dark:text-[#737373]">Fix inaccurate readings or sensor permission blocks.</p>
      </div>
      <button
        id="btn-close-troubleshoot-modal"
        type="button"
        class="rounded-md p-1.5 text-[#888888] hover:bg-[#fafafa] dark:hover:bg-[#1f1f1f] hover:text-[#171717] dark:hover:text-white transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Live Diagnostics Box -->
    <div class="mb-5 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717] p-3.5">
      <span class="text-xs font-mono font-medium text-[#888888] dark:text-[#737373] uppercase block mb-1.5">Live Sensor Diagnostic</span>
      <div class="grid grid-cols-2 gap-2 text-xs font-mono">
        <div>
          <span class="text-[#888888] dark:text-[#737373]">Orientation API:</span>
          <span id="diag-sensor-support" class="text-[#171717] dark:text-white font-semibold ml-1">Checking...</span>
        </div>
        <div>
          <span class="text-[#888888] dark:text-[#737373]">Current Heading:</span>
          <span id="diag-sensor-heading" class="text-[#171717] dark:text-white font-semibold ml-1">--°</span>
        </div>
        <div>
          <span class="text-[#888888] dark:text-[#737373]">Platform:</span>
          <span id="diag-platform-text" class="text-[#171717] dark:text-white ml-1">Browser</span>
        </div>
        <div>
          <span class="text-[#888888] dark:text-[#737373]">Sensor Accuracy:</span>
          <span id="diag-accuracy-text" class="text-emerald-600 dark:text-emerald-400 font-semibold ml-1">Good</span>
        </div>
      </div>
    </div>

    <!-- Step 1: Figure-8 Motion Calibration -->
    <div class="mb-5">
      <h4 class="text-sm font-semibold text-[#171717] dark:text-white mb-2 flex items-center gap-1.5">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#171717] dark:bg-white text-[11px] font-mono text-white dark:text-[#171717]">1</span>
        How to Calibrate Magnetometer (Figure-8)
      </h4>
      <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed mb-3">
        Move your device smoothly through the air in a figure-8 infinity loop pattern 3 to 4 times while holding it flat. This resets device magnetic interference.
      </p>
      <div class="flex justify-center p-3 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#171717]">
        <svg viewBox="0 0 200 100" class="w-48 h-24">
          <path d="M 50,50 C 50,20 100,20 100,50 C 100,80 150,80 150,50 C 150,20 100,20 100,50 C 100,80 50,80 50,50 Z" fill="none" stroke="#0070f3" stroke-width="3" stroke-dasharray="6,4" />
          <circle cx="50" cy="50" r="6" fill="#171717" class="dark:fill-white">
            <animateMotion path="M 0,0 C 0,-30 50,-30 50,0 C 50,30 100,30 100,0 C 100,-30 50,-30 50,0 C 50,30 0,30 0,0 Z" dur="4s" repeatCount="indefinite" />
          </circle>
        </svg>
      </div>
    </div>

    <!-- Step 2: Permission Guidance -->
    <div class="border-t border-[#ebebeb] dark:border-[#262626] pt-4">
      <h4 class="text-sm font-semibold text-[#171717] dark:text-white mb-2 flex items-center gap-1.5">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#171717] dark:bg-white text-[11px] font-mono text-white dark:text-[#171717]">2</span>
        Browser Permission Setup
      </h4>

      <div class="space-y-3 text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">
        <div class="rounded-md border border-[#ebebeb] dark:border-[#262626] p-3 bg-white dark:bg-[#171717]">
          <strong class="text-[#171717] dark:text-white block mb-1">Apple iOS Safari:</strong>
          <p>Go to <em>Settings &gt; Safari &gt; Privacy & Security &gt; Motion & Orientation Access</em> and ensure it is toggled <strong>ON</strong>.</p>
        </div>

        <div class="rounded-md border border-[#ebebeb] dark:border-[#262626] p-3 bg-white dark:bg-[#171717]">
          <strong class="text-[#171717] dark:text-white block mb-1">Google Chrome / Microsoft Edge:</strong>
          <p class="mb-1.5">If the compass dial does not rotate, copy and open this URL in a new tab:</p>
          <code class="block p-1.5 rounded bg-[#f5f5f5] dark:bg-[#262626] text-[11px] font-mono text-[#171717] dark:text-[#ededed] select-all">chrome://flags/#enable-generic-sensor-extra-classes</code>
          <p class="mt-1">Set <strong>Generic Sensor Extra Classes</strong> to <em>Enabled</em> and relaunch browser.</p>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="mt-6 flex justify-end gap-2 border-t border-[#ebebeb] dark:border-[#262626] pt-4">
      <button
        id="btn-recalibrate-action"
        type="button"
        class="rounded-full bg-[#171717] dark:bg-white px-5 py-2 text-xs font-semibold text-white dark:text-[#171717] hover:bg-[#2d2d2d] dark:hover:bg-[#e0e0e0] transition-colors cursor-pointer"
      >
        Done Calibration
      </button>
    </div>
  </div>
</div>
