---
// Navbar.astro - Vercel-inspired sticky navigation with dark/light mode toggle
---

<header class="relative z-40 w-full border-b border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] transition-colors duration-200">
  <div class="mx-auto flex h-14 sm:h-16 max-w-7xl items-center justify-between px-3 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 text-decoration-none group shrink-0 min-w-0">
      <div class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-lg shadow-sm transition-transform group-hover:scale-105 overflow-hidden shrink-0">
        <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
          <defs>
            <linearGradient id="navGoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FCD34D" />
              <stop offset="50%" stop-color="#D97706" />
              <stop offset="100%" stop-color="#B45309" />
            </linearGradient>
          </defs>
          <rect width="512" height="512" fill="#0D0D0E" rx="128" ry="128"/>
          <rect x="12" y="12" width="488" height="488" fill="none" stroke="url(#navGoldGrad)" stroke-width="8" stroke-opacity="0.35" rx="116" ry="116" />
          <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-family="'DM Serif Display', Georgia, serif" fill="url(#navGoldGrad)" font-size="160" letter-spacing="1">Qibla</text>
        </svg>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-sm sm:text-base font-semibold tracking-tight text-[#171717] dark:text-[#ededed] whitespace-nowrap">Qibla Locator</span>
        <span class="text-[10px] sm:text-[11px] font-mono text-[#888888] dark:text-[#737373] -mt-0.5 hidden md:block">Accurate Qibla Compass</span>
      </div>
    </a>

    <!-- Center Nav Links (Desktop & Tablet) -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-medium">
      <a
        href="/"
        class="px-2.5 py-1.5 rounded-full border border-transparent hover:border-[#ebebeb] dark:hover:border-[#262626] text-[#171717] dark:text-white hover:bg-[#fafafa] dark:hover:bg-[#171717] transition-all"
      >
        🧭 Compass
      </a>
      <a
        href="/prayer"
        class="px-2.5 py-1.5 rounded-full border border-transparent hover:border-[#ebebeb] dark:hover:border-[#262626] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#171717] transition-all"
      >
        🕌 Prayer Times
      </a>
      <a
        href="/calendar"
        class="px-2.5 py-1.5 rounded-full border border-transparent hover:border-[#ebebeb] dark:hover:border-[#262626] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#171717] transition-all"
      >
        🌙 Calendar
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Dark/Light Mode Switcher Button -->
      <button
        id="btn-theme-toggle"
        type="button"
        class="inline-flex items-center justify-center h-8 w-8 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors cursor-pointer"
        title="Toggle Light / Dark Mode"
        aria-label="Toggle Dark Mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="hidden h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="h-4 w-4 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Language Button -->
      <button
        id="btn-open-language"
        type="button"
        class="inline-flex items-center gap-1 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] px-2 h-8 text-xs font-medium text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors cursor-pointer"
        title="Select Language"
      >
        <span class="text-xs">🌐</span>
        <span id="nav-lang-label" class="font-mono text-[11px]">EN</span>
      </button>

      <!-- Settings Button -->
      <button
        id="btn-open-settings"
        type="button"
        class="inline-flex items-center justify-center h-8 w-8 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors cursor-pointer"
        aria-label="Settings"
      >
        <svg class="h-4 w-4 text-[#4d4d4d] dark:text-[#a1a1a1]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </button>

      <!-- Share Button (Tablet/Desktop) -->
      <button
        id="btn-share-app"
        type="button"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-[#171717] dark:bg-white px-3.5 py-1.5 text-xs font-semibold text-white dark:text-[#171717] shadow-xs hover:bg-[#2d2d2d] dark:hover:bg-[#e0e0e0] transition-colors cursor-pointer"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>Share</span>
      </button>
    </div>
  </div>
</header>
