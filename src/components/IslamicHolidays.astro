---
// IslamicHolidays.astro - Clean Islamic Festivals Calendar & Nearby Mosques Quick Action
import { getFormattedHijriDate, getUpcomingIslamicFestivals, formatGregorianShort } from '../utils/hijri';

const now = new Date();
const currentHijri = getFormattedHijriDate(now);
const upcomingHolidays = getUpcomingIslamicFestivals(now);
const todayGregorian = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section id="section-holidays" class="scroll-mt-20 py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
  <!-- Section Heading -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-[#ebebeb] dark:border-[#262626] pb-4">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 text-[11px] font-mono text-amber-800 dark:text-amber-300 mb-1.5">
        <span>🌙</span>
        <span>Hijri Calendar</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
        Upcoming Islamic Holidays
      </h2>
    </div>

    <!-- Live Date Bar (Gregorian & Hijri) -->
    <div class="flex items-center gap-3 text-xs font-mono">
      <div class="px-3 py-1.5 rounded-lg bg-[#f5f5f5] dark:bg-[#171717] border border-[#ebebeb] dark:border-[#262626] text-[#4d4d4d] dark:text-[#a1a1a1]">
        <span>{todayGregorian}</span>
      </div>
      <div class="px-3 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 font-semibold">
        <span>{currentHijri.formatted}</span>
      </div>
    </div>
  </div>

  <!-- Holidays Card List Container (iOS Dark Style) -->
  <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] overflow-hidden shadow-xs">
    <div class="divide-y divide-[#ebebeb] dark:divide-[#222222]">
      {upcomingHolidays.map((holiday) => (
        <div class={`flex flex-col sm:flex-row sm:items-center justify-between p-4 sm:px-6 transition-colors hover:bg-[#fafafa] dark:hover:bg-[#181818] ${holiday.isNext ? 'bg-amber-50/40 dark:bg-amber-950/20' : ''}`}>
          <!-- Left: Name & Arabic -->
          <div class="flex items-center gap-3">
            <div class={`h-8 w-8 rounded-full flex items-center justify-center text-sm font-semibold shrink-0 ${holiday.isNext ? 'bg-amber-500 text-white' : 'bg-[#f0f0f0] dark:bg-[#222222] text-[#666666] dark:text-[#a1a1a1]'}`}>
              {holiday.name.charAt(0)}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class={`text-sm sm:text-base font-semibold ${holiday.isNext ? 'text-amber-600 dark:text-amber-400' : 'text-[#171717] dark:text-white'}`}>
                  {holiday.name}
                </span>
                {holiday.isNext && (
                  <span class="rounded-full bg-amber-500 text-white px-2 py-0.5 text-[10px] font-mono uppercase font-bold tracking-wide">
                    Next
                  </span>
                )}
              </div>
              <span class="text-xs font-arabic text-[#888888] dark:text-[#666666]">
                {holiday.arabicName}
              </span>
            </div>
          </div>

          <!-- Right: Hijri Date, Gregorian Date & Countdown -->
          <div class="mt-2 sm:mt-0 flex items-center justify-between sm:justify-end gap-3 text-right">
            <div class="text-left sm:text-right">
              <div class="text-xs font-mono font-medium text-[#171717] dark:text-[#dedede]">
                {holiday.hijriDateStr}
              </div>
              <div class="text-[11px] font-mono text-[#888888] dark:text-[#737373]">
                {formatGregorianShort(holiday.gregorianDate)}
              </div>
            </div>

            <!-- Countdown Pill -->
            <div class="shrink-0">
              <span class={`inline-block px-2.5 py-1 rounded-md text-xs font-mono font-semibold ${
                holiday.daysRemaining === 0
                  ? 'bg-emerald-500 text-white animate-pulse'
                  : holiday.daysRemaining <= 30
                  ? 'bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-200 border border-amber-300 dark:border-amber-700'
                  : 'bg-[#f5f5f5] dark:bg-[#1f1f1f] text-[#666666] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#2a2a2a]'
              }`}>
                {holiday.daysRemaining === 0 ? 'Today 🎉' : `In ${holiday.daysRemaining}d`}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
