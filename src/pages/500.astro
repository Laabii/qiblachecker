---
// 500.astro - Custom 500 Server Error Page
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="500 - Server Error | CheckQibla.com"
  description="An unexpected server error occurred. Please refresh or return to CheckQibla.com."
>
  <Navbar />

  <main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-20 text-center relative overflow-hidden">
    <!-- Atmospheric Background Glow -->
    <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-30 dark:opacity-20 pointer-events-none">
      <div class="h-96 w-96 rounded-full bg-gradient-to-tr from-rose-500 to-amber-500 blur-3xl"></div>
    </div>

    <!-- Error Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 dark:border-amber-900/60 bg-amber-50 dark:bg-amber-950/40 px-3.5 py-1 text-xs font-mono text-amber-700 dark:text-amber-300 mb-6">
      <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span>HTTP 500 — Calculation Interrupted</span>
    </div>

    <!-- Central Error Illustration -->
    <div class="relative w-28 h-28 sm:w-36 sm:h-36 mb-6 flex items-center justify-center">
      <div class="h-20 w-20 sm:h-24 sm:w-24 rounded-full bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-sm flex items-center justify-center">
        <svg class="h-10 w-10 sm:h-12 sm:w-12 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
    </div>

    <!-- Headline & Copy -->
    <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.03em] text-[#171717] dark:text-white mb-3">
      Something Went Wrong
    </h1>
    <p class="text-sm sm:text-base text-[#666666] dark:text-[#a1a1a1] max-w-md mx-auto mb-8 leading-relaxed">
      An unexpected internal error interrupted the request. Don't worry—our mathematical engine and offline PWA compass are ready to guide you.
    </p>

    <!-- Navigation Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <button
        onclick="window.location.reload()"
        type="button"
        class="inline-flex items-center gap-2 rounded-xl bg-[#171717] dark:bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-white dark:text-[#171717] shadow-sm hover:bg-[#2d2d2d] dark:hover:bg-[#f0f0f0] transition-colors cursor-pointer"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reload Page</span>
      </button>

      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] px-5 py-2.5 text-xs sm:text-sm font-medium text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors"
      >
        <span>🏠 Return to Homepage</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
