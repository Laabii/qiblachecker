---
// 404.astro - Custom 404 Not Found Page
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 - Page Not Found | CheckQibla.com"
  description="The page you are looking for could not be found. Return to CheckQibla.com to find the exact Qibla direction and daily prayer times."
>
  <Navbar />

  <main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-20 text-center relative overflow-hidden">
    <!-- Atmospheric Background Glow -->
    <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-30 dark:opacity-20 pointer-events-none">
      <div class="h-96 w-96 rounded-full bg-gradient-to-tr from-blue-500 to-emerald-500 blur-3xl"></div>
    </div>

    <!-- Error Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-rose-200 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/40 px-3.5 py-1 text-xs font-mono text-rose-700 dark:text-rose-300 mb-6">
      <span class="h-2 w-2 rounded-full bg-rose-500 animate-ping"></span>
      <span>HTTP 404 — Direction Lost</span>
    </div>

    <!-- Central Compass SVG Illustration -->
    <div class="relative w-28 h-28 sm:w-36 sm:h-36 mb-6 flex items-center justify-center">
      <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#ebebeb] dark:border-[#262626] animate-spin" style="animation-duration: 25s;"></div>
      <div class="h-20 w-20 sm:h-24 sm:w-24 rounded-full bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-sm flex items-center justify-center">
        <svg class="h-10 w-10 sm:h-12 sm:w-12 text-[#171717] dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10" />
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="#e11d48" stroke="none" />
          <circle cx="12" cy="12" r="1.5" fill="#ffffff" />
        </svg>
      </div>
    </div>

    <!-- Headline & Copy -->
    <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.03em] text-[#171717] dark:text-white mb-3">
      Lost Your Direction?
    </h1>
    <p class="text-sm sm:text-base text-[#666666] dark:text-[#a1a1a1] max-w-md mx-auto mb-8 leading-relaxed">
      The page you are looking for has been moved, deleted, or does not exist. Let’s get you back on track toward the Holy Kaaba.
    </p>

    <!-- Navigation Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-xl bg-[#171717] dark:bg-white px-5 py-2.5 text-xs sm:text-sm font-medium text-white dark:text-[#171717] shadow-sm hover:bg-[#2d2d2d] dark:hover:bg-[#f0f0f0] transition-colors"
      >
        <svg class="h-4 w-4 text-emerald-400 dark:text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 19 21 12 17 5 21 12 2" />
        </svg>
        <span>Open Qibla Compass</span>
      </a>

      <a
        href="/#section-prayer"
        class="inline-flex items-center gap-2 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] px-5 py-2.5 text-xs sm:text-sm font-medium text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors"
      >
        <span>🕌 Prayer Times</span>
      </a>

      <a
        href="/#section-map"
        class="inline-flex items-center gap-2 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#171717] px-5 py-2.5 text-xs sm:text-sm font-medium text-[#171717] dark:text-[#ededed] shadow-xs hover:bg-[#fafafa] dark:hover:bg-[#222222] transition-colors"
      >
        <span>🗺️ Geodesic Map</span>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
