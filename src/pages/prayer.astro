---
// prayer.astro - Dedicated High-Precision Daily Islamic Prayer Times Page
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LocationOverlay from '../components/LocationOverlay.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import PrayerTimesBar from '../components/PrayerTimesBar.astro';
import LocationDetails from '../components/LocationDetails.astro';
import Footer from '../components/Footer.astro';
import TroubleshootingModal from '../components/TroubleshootingModal.astro';
import SettingsModal from '../components/SettingsModal.astro';
---

<Layout
  title="Prayer Times Today - Exact Salah Timings & Countdown | Qibla Locator"
  description="Get 100% accurate daily Islamic prayer times (Fajr, Dhuhr, Asr, Maghrib, Isha) with live countdown to next Salah based on your exact GPS location."
  canonical="https://checkqibla.vercel.app/prayer"
>
  <WelcomeModal />
  <LocationOverlay />
  <Navbar />

  <main class="flex-1 flex flex-col items-center w-full py-4 sm:py-6">
    <!-- Top Back Navigation Banner & Page Header -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full mb-3 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold text-[#171717] dark:text-white bg-white dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] hover:border-emerald-500/60 dark:hover:border-emerald-500/60 shadow-xs hover:shadow-sm transition-all group cursor-pointer"
      >
        <svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Qibla Compass</span>
      </a>

      <div class="flex items-center gap-1.5 text-[11px] font-mono text-[#888888] dark:text-[#737373]">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden sm:inline">Live Salah Schedule</span>
      </div>
    </div>

    <!-- Main Prayer Times Schedule Card & Countdown -->
    <PrayerTimesBar />

    <!-- Location & City Selector -->
    <LocationDetails />

    <!-- Additional Prayer Information & FAQ Section -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-8">
      <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] p-6 sm:p-8 space-y-6">
        <h2 class="text-xl font-bold text-[#171717] dark:text-white">
          How Prayer Times Are Calculated
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
          <div class="p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#181818] space-y-2">
            <h3 class="font-semibold text-sm text-[#171717] dark:text-white">Astronomical Solar Equations</h3>
            <p>
              Prayer times depend on the sun's exact altitude and declination relative to your geographical latitude and longitude. Our engine runs high-precision astronomical algorithms offline in your browser.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#181818] space-y-2">
            <h3 class="font-semibold text-sm text-[#171717] dark:text-white">Juristic & Regional Calculation Methods</h3>
            <p>
              Supports standard conventions including Muslim World League (MWL), ISNA (North America), Umm al-Qura (Makkah), Egyptian General Authority, and University of Islamic Sciences (Karachi).
            </p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-800/40 text-xs text-amber-900 dark:text-amber-200">
          <span class="font-bold">Notice:</span> For congregational prayers, always verify with your local Masjid's official Iqamah schedule.
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <TroubleshootingModal />
  <SettingsModal />

  <script src="../scripts/app.ts"></script>
</Layout>
